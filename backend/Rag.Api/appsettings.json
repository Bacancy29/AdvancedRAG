{
  "ConnectionStrings": {
    "Rag": "Server=.\\SQLEXPRESS;Database=AdvancedRag;Trusted_Connection=True;TrustServerCertificate=True",
    "RagPostgres": "Host=localhost;Port=5432;Database=advancedrag;Username=postgres"
  },
  "Database": {
    "Provider": "Postgres",
    "Dimensions": 768
  },
  "AI": {
    "Chat": {
      "Provider": "Gemini",
      "Model": "gemini-3.5-flash",
      "Temperature": 0,
      "ReasoningEffort": "low",
      "MaxRetries": 1,
      "TimeoutSeconds": 60
    },
    "Embedding": {
      "Provider": "Ollama",
      "Model": "nomic-embed-text",
      "Endpoint": "http://localhost:11434",
      "DocumentPrefix": "search_document: ",
      "QueryPrefix": "search_query: "
    }
  },
  "Reranker": {
    "ModelPath": "models/ms-marco-MiniLM-L-6-v2/model.onnx",
    "VocabPath": "models/ms-marco-MiniLM-L-6-v2/vocab.txt",
    "MaxTokens": 320
  },
  "Rag": {
    "CandidateCount": 20,
    "RerankCount": 12,
    "ContextCount": 5,
    "RrfK": 60,
    "MinRerankScore": -6,
    "MinDenseScore": 0.35,
    "SmallToBigTokenBudget": 2500
  },
  "Routing": {
    "Mode": "Rules",
    "MinWordsForAutoMatch": 2,
    "Aliases": {
      "SAR": "South Asia",
      "EAP": "East Asia and Pacific",
      "ECA": "Europe and Central Asia",
      "LAC": "Latin America and the Caribbean",
      "Latin America": "Latin America and the Caribbean",
      "MNA": "Middle East, North Africa, Afghanistan, and Pakistan",
      "MENA": "Middle East, North Africa, Afghanistan, and Pakistan",
      "MENAAP": "Middle East, North Africa, Afghanistan, and Pakistan",
      "Middle East and North Africa": "Middle East, North Africa, Afghanistan, and Pakistan",
      "SSA": "Sub-Saharan Africa",
      "East Asia": "East Asia and Pacific",
      "Europe and Central Asia region": "Europe and Central Asia"
    }
  },
  "Documents": [
    { "Name": "GPO 2018 Annual Report", "FilePath": "../../GPO-Anual-report.pdf", "Profile": "PlainText" },
    { "Name": "Global Economic Prospects, June 2026", "FilePath": "../../GEP-Jun-2026.pdf", "Profile": "LongReport" },
    { "Name": "Apple iMac Product Environmental Report", "FilePath": "../../iMac_PER_Oct2024.pdf", "Profile": "Visual" }
  ],
  "Cors": { "Origins": [ "http://localhost:5173" ] },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "Urls": "http://localhost:5080",
  "AllowedHosts": "*"
